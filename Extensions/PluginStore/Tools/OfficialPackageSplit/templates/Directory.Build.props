<Project>
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RequireCompileReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PhinixPackage)' == ''" Text="Set PhinixPackage to the installed/built Phinix Mod directory. References are compile-only." />
    <Error Condition="'$(GameReferences)' == ''" Text="Set GameReferences to the RimWorld 1.6 managed assembly directory." />
    <Error Condition="!Exists('$(PhinixPackage)/Common/Assemblies/10-ClientExtensionAbstractions.dll')" Text="PhinixPackage is missing ClientExtensionAbstractions." />
    <Error Condition="!Exists('$(GameReferences)/Assembly-CSharp.dll')" Text="GameReferences is missing Assembly-CSharp.dll." />
  </Target>
</Project>
