    <Copy SourceFiles="$(TargetDir)\Authentication.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\Common\Assemblies\06-Authentication.dll" />
    <Copy SourceFiles="$(TargetDir)\Authentication.Client.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\Common\Assemblies\07-Authentication.Client.dll" />
    <Copy SourceFiles="$(TargetDir)\UserManagement.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\Common\Assemblies\08-UserManagement.dll" />
