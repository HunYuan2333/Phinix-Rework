    <Copy SourceFiles="$(TargetDir)\LiteNetLib.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\Common\Assemblies\01-LiteNetLib.dll" />
    <Copy SourceFiles="$(TargetDir)\Google.Protobuf.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\Common\Assemblies\02-Protobuf.dll" />
    <Copy SourceFiles="$(TargetDir)\Utils.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\Common\Assemblies\03-Utils.dll" />
