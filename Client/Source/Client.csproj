    <Copy SourceFiles="$(TargetDir)\ClientExtensionAbstractions.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\Common\Assemblies\10-ClientExtensionAbstractions.dll" />
    <Copy SourceFiles="$(TargetDir)\PhinixClient.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\$(GameVersion)\Assemblies\13-PhinixClient.dll" />
    <Copy Condition="'$(GameVersion)' == 'Any'" SourceFiles="$(TargetDir)\PhinixClient.dll" DestinationFiles="$(SolutionDir)\Output\phinix-rework\1.6\Assemblies\13-PhinixClient.dll" />

    <PropertyGroup>
      <PhinixCompositionConfiguration>Release</PhinixCompositionConfiguration>
      <PhinixCompositionConfiguration Condition="$(Configuration.StartsWith('Debug'))">Debug</PhinixCompositionConfiguration>
    </PropertyGroup>
    <MSBuild Projects="..\Composition\Phinix.ClientComposition.csproj" Targets="GetTargetPath" Properties="Configuration=$(PhinixCompositionConfiguration);TargetFramework=net472" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="CompositionTarget" />
    </MSBuild>
    <PropertyGroup>
      <PhinixCompositionOutput>@(CompositionTarget->'%(RootDir)%(Directory)')</PhinixCompositionOutput>
    </PropertyGroup>
    <!-- One host-owned copy of the pinned composition runtime and support assets. -->
    <ItemGroup>
      <CompositionRuntimeAsset Include="$(PhinixCompositionOutput)/Phinix.ClientComposition.dll;$(PhinixCompositionOutput)/Autofac.dll;$(PhinixCompositionOutput)/Microsoft.Bcl.AsyncInterfaces.dll;$(PhinixCompositionOutput)/System.Diagnostics.DiagnosticSource.dll;$(PhinixCompositionOutput)/System.Memory.dll;$(PhinixCompositionOutput)/System.Runtime.CompilerServices.Unsafe.dll;$(PhinixCompositionOutput)/System.Numerics.Vectors.dll;$(PhinixCompositionOutput)/System.Buffers.dll;$(PhinixCompositionOutput)/System.Threading.Tasks.Extensions.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CompositionRuntimeAsset)" DestinationFolder="$(SolutionDir)Output/phinix-rework/Common/Assemblies" />

    <!-- Copy static resources from Client source to output -->
    <ItemGroup>
      <AboutResource Include="$(SolutionDir)\Client\About\**\*.*" />
      <DefsResource Include="$(SolutionDir)\Client\Defs\**\*.*" />
      <LanguagesResource Include="$(SolutionDir)\Client\Languages\**\*.*" />
      <TexturesResource Include="$(SolutionDir)\Client\Textures\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AboutResource)" DestinationFolder="$(SolutionDir)\Output\phinix-rework\About\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DefsResource)" DestinationFolder="$(SolutionDir)\Output\phinix-rework\Defs\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LanguagesResource)" DestinationFolder="$(SolutionDir)\Output\phinix-rework\Languages\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TexturesResource)" DestinationFolder="$(SolutionDir)\Output\phinix-rework\Textures\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(SolutionDir)\Client\versions.txt" DestinationFiles="$(SolutionDir)\Output\phinix-rework\LoadFolders.xml" SkipUnchangedFiles="true" />

    <!-- Copy client source code to output for reference -->
    <ItemGroup>
      <SourceResource Include="$(SolutionDir)\Client\Source\**\*.cs" />
      <SourceResource Include="$(SolutionDir)\Client\Source\**\*.csproj" />
    </ItemGroup>
    <Copy SourceFiles="@(SourceResource)" DestinationFolder="$(SolutionDir)\Output\phinix-rework\Source\%(RecursiveDir)" SkipUnchangedFiles="true" />

    <!-- Copy ClientExtensionAbstractions source for reference -->
    <ItemGroup>
      <AbstractionsSource Include="$(SolutionDir)\Client\ClientExtensionAbstractions\**\*.cs" />
      <AbstractionsSource Include="$(SolutionDir)\Client\ClientExtensionAbstractions\**\*.csproj" />
    </ItemGroup>
    <Copy SourceFiles="@(AbstractionsSource)" DestinationFolder="$(SolutionDir)\Output\phinix-rework\Abstractions\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
